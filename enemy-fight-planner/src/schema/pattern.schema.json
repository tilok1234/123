{
  "$id": "pattern.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pattern",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "params": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "ops": {
      "type": "array",
      "items": { "$ref": "#/definitions/PatternOp" }
    }
  },
  "required": ["id", "ops"],
  "definitions": {
    "PatternOp": {
      "type": "object",
      "properties": {
        "type": { "type": "string" }
      },
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "Wait" },
            "ticks": { "type": ["number", "string"] }
          },
          "required": ["ticks"]
        },
        {
          "properties": {
            "type": { "const": "Fire" },
            "projectile": { "type": "string" },
            "angle": { "type": ["number", "string"] },
            "speed": { "type": ["number", "string"] }
          },
          "required": ["projectile"]
        },
        {
          "properties": {
            "type": { "const": "FireRing" },
            "projectile": { "type": "string" },
            "count": { "type": ["number", "string"] },
            "speed": { "type": ["number", "string"] },
            "radius": { "type": ["number", "string"] }
          },
          "required": ["projectile", "count"]
        },
        {
          "properties": {
            "type": { "const": "FireArc" },
            "projectile": { "type": "string" },
            "count": { "type": ["number", "string"] },
            "spread": { "type": ["number", "string"] },
            "direction": { "type": ["number", "string"] },
            "speed": { "type": ["number", "string"] }
          },
          "required": ["projectile", "count", "spread", "direction"]
        },
        {
          "properties": {
            "type": { "const": "Loop" },
            "count": { "type": ["number", "string"] },
            "ops": {
              "type": "array",
              "items": { "$ref": "#/definitions/PatternOp" }
            }
          },
          "required": ["count", "ops"]
        },
        {
          "properties": {
            "type": { "const": "SpawnSubpattern" },
            "patternId": { "type": "string" }
          },
          "required": ["patternId"]
        },
        {
          "properties": {
            "type": { "const": "Set" },
            "param": { "type": "string" },
            "value": { "type": ["number", "string"] }
          },
          "required": ["param", "value"]
        }
      ]
    }
  }
}
