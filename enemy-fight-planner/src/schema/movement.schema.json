{
  "$id": "movement.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Movement",
  "type": "object",
  "properties": {
    "type": { "type": "string", "enum": ["Linear", "Accelerating", "Homing"] },
    "acceleration": { "type": "number" },
    "maxSpeed": { "type": "number" },
    "turnRate": { "type": "number" }
  },
  "required": ["type"]
}
